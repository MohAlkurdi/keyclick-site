---
import "@fontsource-variable/hanken-grotesk/index.css";
import packs from "../data/packs.json";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const repo = "https://github.com/MohAlkurdi/keyclick";
const download = `${repo}/releases/latest/download/KeyClick.zip`;
const agentPrompt = "Install KeyClick on this Mac by following https://raw.githubusercontent.com/MohAlkurdi/keyclick/main/INSTALL.md";
const source = `${repo}/blob/main/Sources/KeyClick/Clicker.swift`;
// A tip page (Ko-fi, GitHub Sponsors…). Empty hides the tip link.
const tipUrl = "";

// Cherry MX stem colours; Topre's is the purple of the recorded Topre Purple Hybrid.
const stems: Record<string, string> = {
  "mx-brown": "#c08552",
  "mx-black": "#c9c9ce",
  "mx-red": "#ff5147",
  "mx-blue": "#4b93ff",
  topre: "#a582ff",
};

// [code, legend, width in keys, shifted legend or modifier symbol, legend side]
type Key = [string, string, number?, string?, ("l" | "r")?];
const fnRow: Key[] = [
  ["Escape", "esc", 1.5, "", "l"],
  ...Array.from({ length: 12 }, (_, i): Key => [`F${i + 1}`, `F${i + 1}`]),
];
const mainRows: Key[][] = [
  [
    ["Backquote", "`", 1, "~"],
    ...[..."1234567890"].map((d, i): Key => [`Digit${d}`, d, 1, "!@#$%^&*()"[i]]),
    ["Minus", "-", 1, "_"],
    ["Equal", "=", 1, "+"],
    ["Backspace", "delete", 1.5, "", "r"],
  ],
  [
    ["Tab", "tab", 1.5, "⇥", "l"],
    ...[..."QWERTYUIOP"].map((c): Key => [`Key${c}`, c]),
    ["BracketLeft", "[", 1, "{"],
    ["BracketRight", "]", 1, "}"],
    ["Backslash", "\\", 1, "|"],
  ],
  [
    ["CapsLock", "caps lock", 1.8, "⇪", "l"],
    ...[..."ASDFGHJKL"].map((c): Key => [`Key${c}`, c]),
    ["Semicolon", ";", 1, ":"],
    ["Quote", "'", 1, '"'],
    ["Enter", "return", 1.7, "", "r"],
  ],
  [
    ["ShiftLeft", "shift", 2.3, "⇧", "l"],
    ...[..."ZXCVBNM"].map((c): Key => [`Key${c}`, c]),
    ["Comma", ",", 1, "<"],
    ["Period", ".", 1, ">"],
    ["Slash", "/", 1, "?"],
    ["ShiftRight", "shift", 2.2, "⇧", "r"],
  ],
];
const bottomRow: Key[] = [
  ["Fn", "fn", 1, "", "l"],
  ["ControlLeft", "control", 1, "⌃", "l"],
  ["AltLeft", "option", 1, "⌥", "l"],
  ["MetaLeft", "command", 1.3, "⌘", "l"],
  ["Space", "", 5.1],
  ["MetaRight", "command", 1.3, "⌘", "r"],
  ["AltRight", "option", 1, "⌥", "r"],
];
const isWord = (legend: string) => legend.length > 2 && !/^F\d+$/.test(legend);
const waveRows = [...mainRows, bottomRow];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KeyClick: your MacBook keyboard, now mechanical</title>
    <meta
      name="description"
      content="KeyClick is a free, open-source Mac menu bar app that plays a real mechanical switch recording for every key you press."
    />
    <meta property="og:title" content="KeyClick: your MacBook keyboard, now mechanical" />
    <meta property="og:description" content="Free and open source. Every key has its own recording." />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body style={`--stem: ${stems[packs[0].slug]}`}>
    <header class="nav wrap">
      <a class="brand" href={base}>
        <img src={`${base}favicon.svg`} alt="" width="22" height="22" />
        KeyClick
      </a>
      <nav aria-label="Main">
        <a href="#test">Type test</a>
        <a href="#sounds">Sounds</a>
        <a href="#privacy">Privacy</a>
        <a href={repo}>GitHub</a>
        <a class="btn btn-sm" href="#get">Install</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="title">
        <div class="wrap hero-copy">
          <h1 id="title">Your MacBook keyboard,<br /> now mechanical.</h1>
          <p class="lede">
            KeyClick plays a real switch recording every time you press and release a key. Free, open source, and it
            lives in your menu bar.
          </p>
          <div class="cta">
            <a class="btn" href="#get">Install KeyClick</a>
            <span class="req">macOS 13 or later · Apple silicon and Intel</span>
          </div>
        </div>

        <div class="stage">
          <input class="capture" id="capture" aria-label="Type here to hear KeyClick" autocomplete="off" autocapitalize="off" spellcheck="false" />
          <p class="echo" aria-hidden="true"><span id="echo"></span><span class="caret"></span></p>
          <div class="kb-frame">
            <div class="kb" id="kb" data-mech="false" role="img" aria-label="A MacBook keyboard. Press any key, or tap one, to hear KeyClick.">
              <div class="row row-fn">
                {
                  fnRow.map(([code, legend, w = 1, , side]) => (
                    <div class="key" data-code={code} data-side={side} style={`--w:${w}`}>
                      <span class="cap"><span class="face"><span class="main small">{legend}</span></span></span>
                    </div>
                  ))
                }
                <div class="key key-touch" style="--w:1"><span class="cap"><span class="face"><span class="ring"></span></span></span></div>
              </div>
              {
                mainRows.map((row) => (
                  <div class="row">
                    {row.map(([code, legend, w = 1, alt, side]) => (
                      <div class="key" data-code={code} data-side={side} style={`--w:${w}`}>
                        <span class="cap">
                          <span class="face">
                            {alt && <span class="alt">{alt}</span>}
                            <span class:list={["main", { small: isWord(legend) }]}>{legend}</span>
                          </span>
                        </span>
                      </div>
                    ))}
                  </div>
                ))
              }
              <div class="row">
                {
                  bottomRow.map(([code, legend, w = 1, alt, side]) => (
                    <div class="key" data-code={code} data-side={side} style={`--w:${w}`}>
                      <span class="cap">
                        <span class="face">
                          {alt && <span class="alt">{alt}</span>}
                          <span class="main small">{legend}</span>
                        </span>
                      </span>
                    </div>
                  ))
                }
                <div class="arrows" style="--w:3">
                  <div class="key" data-code="ArrowLeft"><span class="cap"><span class="face"><span class="main tiny">◀</span></span></span></div>
                  <div class="key" data-code="ArrowUp"><span class="cap"><span class="face"><span class="main tiny">▲</span></span></span></div>
                  <div class="key" data-code="ArrowDown"><span class="cap"><span class="face"><span class="main tiny">▼</span></span></span></div>
                  <div class="key" data-code="ArrowRight"><span class="cap"><span class="face"><span class="main tiny">▶</span></span></span></div>
                </div>
              </div>
            </div>
          </div>

          <div class="controls wrap">
            <button class="power" id="power" role="switch" aria-checked="true">
              <span class="track"><span class="thumb"></span></span>
              <span><strong>KeyClick</strong> <span id="power-state">On</span></span>
            </button>
            <div class="stems" role="radiogroup" aria-label="Switch">
              {
                packs.map((p, i) => (
                  <button
                    class="stem"
                    role="radio"
                    aria-checked={i === 0 ? "true" : "false"}
                    tabindex={i === 0 ? 0 : -1}
                    data-pack={p.slug}
                    style={`--c:${stems[p.slug]}`}>
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      {p.slug === "topre" ? (
                        <circle cx="10" cy="10" r="6" />
                      ) : (
                        <path d="M8.2 3h3.6v5.2H17v3.6h-5.2V17H8.2v-5.2H3V8.2h5.2z" />
                      )}
                    </svg>
                    <span class="stem-name">{p.name}</span>
                    {p.type !== p.name && <span class="stem-type">{p.type}</span>}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="test wrap" id="test" aria-labelledby="test-title">
        <div class="test-head">
          <div class="section-head">
            <h2 id="test-title">Take it for a type test.</h2>
            <p>Words per minute, with every keystroke on <span id="test-pack">{packs[0].name}</span>.</p>
          </div>
          <div class="modes" aria-label="Test length">
            {
              [15, 30, 60].map((s) => (
                <button class="mode" type="button" aria-pressed={s === 30 ? "true" : "false"} data-seconds={s}>
                  {s}s
                </button>
              ))
            }
          </div>
        </div>
        <div class="test-box" id="test-box">
          <p class="test-time" id="test-time" aria-hidden="true">30</p>
          <div class="words" id="words" aria-hidden="true"><div class="words-inner" id="words-inner"></div></div>
          <input
            class="test-input"
            id="test-input"
            aria-label="Type the words shown"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
          />
          <p class="test-focus">Click here, then start typing</p>
          <div class="test-result" id="test-result" aria-live="polite" hidden>
            <dl>
              <div class="stat big"><dt>wpm</dt><dd id="r-wpm"></dd></div>
              <div class="stat big"><dt>accuracy</dt><dd id="r-acc"></dd></div>
              <div class="stat"><dt>raw</dt><dd id="r-raw"></dd></div>
              <div class="stat"><dt>correct / wrong / extra / missed</dt><dd id="r-chars"></dd></div>
              <div class="stat"><dt>switch</dt><dd id="r-switch"></dd></div>
            </dl>
            <button class="btn" type="button" id="test-again">Next test</button>
          </div>
        </div>
        <p class="test-hint"><kbd>tab</kbd> or <kbd>esc</kbd> starts over</p>
      </section>

      <section class="voices wrap" id="sounds" aria-labelledby="voices-title">
        <div class="section-head">
          <h2 id="voices-title">Every key has its own sound.</h2>
          <p>
            The switches were recorded one key at a time, press and release. So the space bar sounds like a space bar,
            and shift sounds like shift. Here is every key of <span id="voices-pack">{packs[0].name}</span>, drawn from
            the real recordings.
          </p>
        </div>
        <div class="wave-map" id="wave-map" aria-hidden="true">
          {
            waveRows.map((row) => (
              <div class="wave-row">
                {row.map(([code, legend, w = 1]) => (
                  <div class="tile" data-code={code} style={`--w:${w}`}>
                    <span class="tile-label">{code === "Space" ? "space" : legend}</span>
                    <svg viewBox="0 0 40 20" preserveAspectRatio="none"><path></path></svg>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
      </section>

      <section class="menubar-sec wrap" aria-labelledby="menu-title">
        <div class="section-head">
          <h2 id="menu-title">Lives in your menu bar.</h2>
          <p>No window and no Dock icon. One click turns it off for a call, changes the volume, or picks a switch. This panel works.</p>
        </div>
        <div class="desk">
          <div class="menubar">
            <span class="mb-icon" aria-hidden="true">
              <svg viewBox="0 0 20 14"><rect x="1" y="1" width="18" height="12" rx="2.5"></rect><path d="M4.5 5h1M7.5 5h1M10.5 5h1M13.5 5h1M4.5 8h1M13.5 8h1M7 10.5h6M7.5 8h5"></path></svg>
            </span>
          </div>
          <div class="popover">
            <div class="pop-row">
              <span id="menu-sound-label">Sound</span>
              <button class="mac-switch" id="menu-sound" role="switch" aria-checked="true" aria-labelledby="menu-sound-label"></button>
            </div>
            <div class="pop-row pop-stack">
              <label for="menu-volume">Volume</label>
              <input id="menu-volume" type="range" min="0" max="1" step="0.01" value="0.8" />
            </div>
            <div class="pop-row">
              <label for="menu-pack">Switch</label>
              <select id="menu-pack">{packs.map((p) => <option value={p.slug}>{p.name}</option>)}</select>
            </div>
            <div class="pop-row" inert><span>Open at login</span><span class="mac-switch" aria-hidden="true"></span></div>
            <hr />
            <div class="pop-row" inert><span>Quit KeyClick</span></div>
          </div>
        </div>
      </section>

      <section class="privacy wrap" id="privacy" aria-labelledby="privacy-title">
        <h2 id="privacy-title">It hears the key.<br /> It keeps nothing.</h2>
        <div class="proof">
          <ul class="claims">
            <li><strong>Listen-only.</strong> It notices which key moved, to play that key's sound. It cannot change or block anything you type.</li>
            <li><strong>Nothing leaves your Mac.</strong> No network code, no logs, no history. macOS hides password fields from it.</li>
            <li><strong>Small enough to read.</strong> The whole app is about 200 lines of Swift. <a href={source}>Read the part that listens</a>.</li>
          </ul>
          <figure class="code">
            <figcaption>Sources/KeyClick/Clicker.swift</figcaption>
            <pre><code><span class="c-kw">let</span> mask = (<span class="c-n">1</span> &lt;&lt; <span class="c-t">CGEventType</span>.keyDown.rawValue)
    | (<span class="c-n">1</span> &lt;&lt; <span class="c-t">CGEventType</span>.keyUp.rawValue)
    | (<span class="c-n">1</span> &lt;&lt; <span class="c-t">CGEventType</span>.flagsChanged.rawValue)
tap = <span class="c-t">CGEvent</span>.tapCreate(
    tap: .cgSessionEventTap,
    place: .headInsertEventTap,
    options: <mark>.listenOnly</mark>,
    eventsOfInterest: <span class="c-t">CGEventMask</span>(mask),
    …
)</code></pre>
          </figure>
        </div>
      </section>

      <section class="get wrap" id="get" aria-labelledby="get-title">
        <h2 id="get-title">Get KeyClick.</h2>
        <p class="get-lede">
          Paste this into Claude Code, Codex or any agent that runs terminal commands. It installs KeyClick and tells you
          the one setting to turn on.
        </p>
        <code class="prompt" id="agent-prompt">{agentPrompt}</code>
        <button class="key big-key" type="button" id="agent-copy" data-code="Enter">
          <span class="cap"><span class="face"><span class="big-key-label">Copy prompt</span><span class="alt">Free · macOS 13 or later</span></span></span>
        </button>
        <details class="manual">
          <summary>Or install it yourself</summary>
          <ol class="steps">
            <li><a href={download}>Download KeyClick.zip</a>, unzip it and move KeyClick to Applications.</li>
            <li>First launch is blocked: open System Settings → Privacy &amp; Security and click Open Anyway.</li>
            <li>Allow it in System Settings, Privacy &amp; Security, Input Monitoring.</li>
          </ol>
        </details>
        <p class="fine">
          Free and open source under the MIT license. <a href={repo}>Source on GitHub</a>{
            tipUrl && (
              <>
                {" · "}
                <a href={tipUrl}>Leave a tip</a>
              </>
            )
          }
        </p>
      </section>
    </main>

    <footer class="foot wrap">
      <p>Switch recordings from <a href="https://github.com/hainguyents13/mechvibes">Mechvibes</a> by Hai Nguyen, MIT license.</p>
      <p>Made by <a href="https://github.com/MohAlkurdi">MohAlkurdi</a>.</p>
    </footer>

    <script>
      import packs from "../data/packs.json";

      type Pack = (typeof packs)[number];
      type Slot = [number, number];
      type Action = "press" | "release";

      const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

      const kb = $("kb");
      const keyEls = new Map<string, HTMLElement>();
      for (const el of kb.querySelectorAll<HTMLElement>(".key[data-code]")) keyEls.set(el.dataset.code!, el);
      const tiles = new Map<string, HTMLElement>();
      for (const el of document.querySelectorAll<HTMLElement>(".tile")) tiles.set(el.dataset.code!, el);

      // The sprite is mono; place each key in the stereo field where it sits on the keyboard.
      const pans = new Map<string, number>();
      function measurePans() {
        const box = kb.getBoundingClientRect();
        for (const [code, el] of keyEls) {
          const r = el.getBoundingClientRect();
          pans.set(code, ((r.left + r.width / 2 - box.left) / box.width - 0.5) * 0.9);
        }
      }

      const ctx = new AudioContext();
      const master = ctx.createGain();
      master.gain.value = 0.8;
      master.connect(ctx.destination);
      const buffers = new Map<string, Promise<AudioBuffer>>();
      let pack: Pack = packs.find((p) => p.slug === localStorage.getItem("keyclick-pack")) ?? packs[0];
      let on = true;

      function load(p: Pack) {
        let buffer = buffers.get(p.slug);
        if (!buffer) {
          buffer = fetch(`${base}sounds/${p.slug}.wav`)
            .then((r) => (r.ok ? r.arrayBuffer() : Promise.reject(new Error(r.statusText))))
            .then((data) => ctx.decodeAudioData(data));
          buffers.set(p.slug, buffer);
          buffer.catch(() => {
            buffers.delete(p.slug);
            echoHint("The sound did not load. Pick a switch to try again.");
          });
        }
        return buffer;
      }

      function slotFor(p: Pack, action: Action, code: string): Slot | undefined {
        const table = p[action] as Record<string, Slot>;
        if (table[code]) return table[code];
        const letters = Object.keys(table).filter((k) => k.startsWith("Key"));
        return table[letters[Math.floor(Math.random() * letters.length)]];
      }

      async function play(action: Action, code: string) {
        if (!on) return;
        if (ctx.state === "suspended") ctx.resume();
        const p = pack;
        const slot = slotFor(p, action, code);
        if (!slot) return;
        const buffer = await load(p);
        const src = ctx.createBufferSource();
        src.buffer = buffer;
        const gain = ctx.createGain();
        gain.gain.value = 0.85 + Math.random() * 0.15;
        const pan = ctx.createStereoPanner();
        pan.pan.value = pans.get(code) ?? 0;
        src.connect(gain).connect(pan).connect(master);
        src.start(0, slot[0], slot[1]);
      }

      const held = new Set<string>();
      function press(code: string) {
        held.add(code);
        keyEls.get(code)?.classList.add("down");
        tiles.get(code)?.classList.add("hit");
        play("press", code);
      }
      function release(code: string) {
        held.delete(code);
        keyEls.get(code)?.classList.remove("down");
        const tile = tiles.get(code);
        if (tile) setTimeout(() => tile.classList.remove("hit"), 140);
        play("release", code);
      }

      // What you type, echoed above the keyboard.
      const echo = $("echo");
      let typed = "";
      function echoHint(text: string) {
        echo.textContent = text;
        echo.classList.add("hint");
      }
      function echoKey(key: string) {
        if (key === "Backspace") typed = typed.slice(0, -1);
        else if (key === "Enter") typed += " ";
        else if (key.length === 1) typed += key;
        else return;
        typed = typed.slice(-42);
        echo.textContent = typed;
        echo.classList.toggle("hint", !typed);
        if (!typed) echoHint("Type anything. You are hearing KeyClick.");
      }
      echoHint("Type anything. You are hearing KeyClick.");

      // Keys that would scroll or search the page instead of typing.
      const pageKeys = new Set(["Space", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Slash", "Quote", "Backspace"]);
      function tap(code: string) {
        press(code);
        setTimeout(() => release(code), 110);
      }
      // macOS browsers send caps lock as a toggle: keydown when it turns on, keyup when it turns off.
      const capsToggles = /Mac|iPhone|iPad/.test(navigator.platform);
      // Vim-style extensions (Vimium, Surfingkeys) swallow keys unless a text field has focus, so the page types
      // into this hidden field rather than the body.
      const capture = $<HTMLInputElement>("capture");
      const typing = (e: Event) =>
        e.target !== capture && (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement);
      addEventListener("keydown", (e) => {
        const onPage = e.target === document.body || e.target === capture;
        if (onPage && !e.metaKey && !e.ctrlKey && (pageKeys.has(e.code) || e.key.length === 1)) e.preventDefault();
        if ((e.metaKey || e.ctrlKey) && e.code === "KeyA" && !typing(e)) e.preventDefault();
        if (e.repeat) return;
        if (e.code === "CapsLock") return tap(e.code);
        press(e.code);
        if (!e.metaKey && !e.ctrlKey && !typing(e)) echoKey(e.key);
      });
      // A mouse click anywhere that is not a control or a text selection hands typing back to the page.
      addEventListener("pointerup", (e) => {
        if (e.pointerType !== "mouse" || !getSelection()!.isCollapsed) return;
        if ((e.target as Element).closest("input, select, textarea, #test-box, .prompt")) return;
        capture.focus({ preventScroll: true });
      });
      if (matchMedia("(pointer: fine)").matches) capture.focus({ preventScroll: true });
      addEventListener("keyup", (e) => {
        if (e.code === "CapsLock") return capsToggles && tap(e.code);
        release(e.code);
        // macOS sends no keyup for keys pressed while command is held.
        if (e.key === "Meta") for (const code of held) release(code);
      });
      addEventListener("blur", () => {
        for (const code of held) release(code);
      });

      // Touch and mouse: every key on the drawing, and every waveform, can be pressed.
      for (const [code, el] of [...keyEls, ...tiles]) {
        let held = false;
        el.addEventListener("pointerdown", (e) => {
          e.preventDefault();
          held = true;
          press(code);
          echoKey(code.startsWith("Key") ? code.slice(3).toLowerCase() : { Space: " ", Backspace: "Backspace", Enter: "Enter" }[code] ?? "");
        });
        const up = () => {
          if (!held) return;
          held = false;
          release(code);
        };
        el.addEventListener("pointerup", up);
        el.addEventListener("pointerleave", up);
        el.addEventListener("pointercancel", up);
      }

      // Waveform map: every key of the selected switch, from the decoded sprite.
      function drawWaves(p: Pack, buffer: AudioBuffer) {
        const data = buffer.getChannelData(0);
        const rate = buffer.sampleRate;
        for (const [code, tile] of tiles) {
          const slot = (p.press as Record<string, Slot>)[code];
          const path = tile.querySelector("path")!;
          if (!slot) {
            path.setAttribute("d", "M0 10H40");
            continue;
          }
          const from = Math.floor(slot[0] * rate);
          const len = Math.floor(slot[1] * rate);
          const n = 24;
          let d = "";
          for (let i = 0; i < n; i++) {
            let peak = 0;
            const a = from + Math.floor((i * len) / n);
            const b = from + Math.floor(((i + 1) * len) / n);
            for (let j = a; j < b; j++) peak = Math.max(peak, Math.abs(data[j]));
            const h = Math.max(0.3, Math.min(9.5, Math.sqrt(peak) * 13));
            d += `M${((i + 0.5) * 40) / n} ${10 - h}V${10 + h}`;
          }
          path.setAttribute("d", d);
        }
      }

      const stemButtons = [...document.querySelectorAll<HTMLButtonElement>(".stem")];
      const menuPack = $<HTMLSelectElement>("menu-pack");
      const stems = Object.fromEntries(stemButtons.map((b) => [b.dataset.pack!, b.style.getPropertyValue("--c")]));

      function select(p: Pack) {
        pack = p;
        localStorage.setItem("keyclick-pack", p.slug);
        document.body.style.setProperty("--stem", stems[p.slug]);
        for (const b of stemButtons) {
          const active = b.dataset.pack === p.slug;
          b.setAttribute("aria-checked", String(active));
          b.tabIndex = active ? 0 : -1;
        }
        menuPack.value = p.slug;
        $("voices-pack").textContent = p.name;
        $("test-pack").textContent = p.name;
        load(p).then((buffer) => pack === p && drawWaves(p, buffer));
      }

      stemButtons.forEach((b, i) => {
        b.addEventListener("click", (e) => {
          select(packs[i]);
          if (e.detail > 0) {
            press("KeyK");
            setTimeout(() => release("KeyK"), 110);
          }
        });
        b.addEventListener("keydown", (e) => {
          const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
          if (!step) return;
          e.preventDefault();
          const next = (i + step + packs.length) % packs.length;
          select(packs[next]);
          stemButtons[next].focus();
        });
      });
      menuPack.addEventListener("change", () => select(packs.find((p) => p.slug === menuPack.value)!));

      // On/off: off means a silent, flat MacBook keyboard.
      const switches = [$("power"), $("menu-sound")];
      function setOn(value: boolean) {
        on = value;
        for (const s of switches) s.setAttribute("aria-checked", String(on));
        $("power-state").textContent = on ? "On" : "Off";
        kb.dataset.mech = String(on);
      }
      for (const s of switches) s.addEventListener("click", () => setOn(!on));
      $<HTMLInputElement>("menu-volume").addEventListener("input", (e) => {
        master.gain.value = Number((e.target as HTMLInputElement).value);
      });

      const bigKey = document.querySelector<HTMLElement>(".big-key")!;
      bigKey.addEventListener("pointerdown", () => {
        bigKey.classList.add("down");
        play("press", "Enter");
      });
      bigKey.addEventListener("pointerup", () => {
        bigKey.classList.remove("down");
        play("release", "Enter");
      });
      bigKey.addEventListener("pointerleave", () => bigKey.classList.remove("down"));

      const copyLabel = bigKey.querySelector(".big-key-label")!;
      bigKey.addEventListener("click", async () => {
        await navigator.clipboard.writeText($("agent-prompt").textContent!);
        copyLabel.textContent = "Copied";
        setTimeout(() => (copyLabel.textContent = "Copy prompt"), 1600);
      });

      // Type test: Monkeytype-style timed run over common words.
      const WORDS = (
        "the be of and a to in he have it that for they with as not on she at by this we you do but from or which one " +
        "would all will there say who make when can more if no man out other so what time up go about than into could " +
        "state only new year some take come these know see use get like then first any work now may such give over " +
        "think most even find day also after way many must look before great back through long where much should well " +
        "people down own just because good each those feel seem how high too place little world very still nation hand " +
        "old life tell write become here show house both between need mean call develop under last right move thing " +
        "general school never same another begin while number part turn real leave might want point form off child few " +
        "small since against ask late home interest large person end open public follow during present without again " +
        "hold around possible head consider word program problem however lead system set order eye plan run keep face " +
        "fact group play stand increase early course change help line"
      ).split(" ");
      const testBox = $("test-box");
      const wordsBox = $("words");
      const inner = $("words-inner");
      const input = $<HTMLInputElement>("test-input");
      const timeEl = $("test-time");
      const result = $("test-result");
      const caret = document.createElement("span");
      caret.className = "test-caret";
      const modes = [...document.querySelectorAll<HTMLButtonElement>(".mode")];
      let seconds = 30;
      let words: string[] = [];
      let entered: string[] = [];
      let wordEls: HTMLElement[] = [];
      let wi = 0;
      let startedAt = 0;
      let timer = 0;
      let keystrokes = 0;
      let rightKeystrokes = 0;

      function addWords(n: number) {
        for (let i = 0; i < n; i++) {
          let w;
          do w = WORDS[Math.floor(Math.random() * WORDS.length)];
          while (w === words[words.length - 1]);
          words.push(w);
          const el = document.createElement("span");
          el.className = "word";
          wordEls.push(el);
          inner.append(el);
          renderWord(words.length - 1);
        }
      }

      function renderWord(i: number) {
        const w = words[i];
        const t = entered[i] ?? "";
        const letters = [];
        for (let j = 0; j < Math.max(w.length, t.length); j++) {
          const letter = document.createElement("span");
          letter.textContent = j < w.length ? w[j] : t[j];
          if (j >= w.length) letter.className = "extra";
          else if (j < t.length) letter.className = t[j] === w[j] ? "ok" : "bad";
          letters.push(letter);
        }
        wordEls[i].replaceChildren(...letters);
        wordEls[i].classList.toggle("err", i < wi && t !== w);
      }

      function placeCaret() {
        const el = wordEls[wi];
        const n = (entered[wi] ?? "").length;
        const letter = el.children[Math.min(n, el.children.length - 1)] as HTMLElement;
        const left = n < el.children.length ? letter.offsetLeft : letter.offsetLeft + letter.offsetWidth;
        caret.style.transform = `translate(${left}px, ${el.offsetTop}px)`;
        // Keep the current line second of three once the first line is done.
        const line = el.offsetHeight;
        inner.style.transform = `translateY(${-Math.max(0, Math.round(el.offsetTop / line) - 1) * line}px)`;
      }

      function reset() {
        clearInterval(timer);
        startedAt = 0;
        words = [];
        entered = [""];
        wordEls = [];
        wi = 0;
        keystrokes = rightKeystrokes = 0;
        inner.replaceChildren(caret);
        inner.style.transform = "";
        addWords(60);
        timeEl.textContent = String(seconds);
        testBox.classList.remove("running", "done");
        result.hidden = true;
        input.hidden = false;
        placeCaret();
      }

      function finish() {
        clearInterval(timer);
        const minutes = seconds / 60;
        let right = 0, wrong = 0, extra = 0, missed = 0, raw = 0, counted = 0;
        for (let i = 0; i <= wi; i++) {
          const w = words[i];
          const t = entered[i] ?? "";
          const done = i < wi;
          for (let j = 0; j < Math.max(w.length, t.length); j++) {
            if (j >= t.length) missed += done ? 1 : 0;
            else if (j >= w.length) extra++;
            else if (t[j] === w[j]) right++;
            else wrong++;
          }
          raw += t.length + (done ? 1 : 0);
          // WPM counts only words entered right, plus their spaces; the unfinished last word counts if right so far.
          if (done ? t === w : w.startsWith(t)) counted += t.length + (done ? 1 : 0);
        }
        $("r-wpm").textContent = String(Math.round(counted / 5 / minutes));
        $("r-acc").textContent = `${keystrokes ? Math.round((rightKeystrokes / keystrokes) * 100) : 0}%`;
        $("r-raw").textContent = String(Math.round(raw / 5 / minutes));
        $("r-chars").textContent = `${right} / ${wrong} / ${extra} / ${missed}`;
        $("r-switch").textContent = pack.name;
        testBox.classList.remove("running");
        testBox.classList.add("done");
        input.hidden = true;
        result.hidden = false;
        $("test-again").focus();
      }

      function type(ch: string) {
        if (!startedAt) {
          startedAt = performance.now();
          testBox.classList.add("running");
          timer = window.setInterval(() => {
            const left = seconds - (performance.now() - startedAt) / 1000;
            timeEl.textContent = String(Math.max(0, Math.ceil(left)));
            if (left <= 0) finish();
          }, 100);
        }
        const w = words[wi];
        const t = entered[wi];
        keystrokes++;
        if (ch === " ") {
          if (!t) return keystrokes--;
          if (t === w) rightKeystrokes++;
          wi++;
          entered[wi] = "";
          renderWord(wi - 1);
          if (words.length - wi < 30) addWords(30);
          return;
        }
        if (w[t.length] === ch) rightKeystrokes++;
        if (t.length < w.length + 8) entered[wi] = t + ch;
        renderWord(wi);
      }

      function back(wholeWord: boolean) {
        if (!entered[wi] && wi > 0 && entered[wi - 1] !== words[wi - 1]) {
          wi--;
          renderWord(wi + 1);
          if (!wholeWord) return renderWord(wi);
        }
        entered[wi] = wholeWord ? "" : entered[wi].slice(0, -1);
        renderWord(wi);
      }

      input.addEventListener("beforeinput", (e) => {
        e.preventDefault();
        if (testBox.classList.contains("done")) return;
        if (e.inputType === "insertText" && e.data) for (const ch of e.data) type(ch);
        else if (e.inputType === "deleteContentBackward") back(false);
        else if (e.inputType.startsWith("delete")) back(true);
        placeCaret();
      });
      testBox.addEventListener("keydown", (e) => {
        if (e.key !== "Tab" && e.key !== "Escape") return;
        e.preventDefault();
        reset();
        input.focus();
      });
      $("test-again").addEventListener("click", () => {
        reset();
        input.focus();
      });
      for (const m of modes) {
        m.addEventListener("click", () => {
          seconds = Number(m.dataset.seconds);
          for (const o of modes) o.setAttribute("aria-pressed", String(o === m));
          reset();
          input.focus();
        });
      }
      new ResizeObserver(placeCaret).observe(wordsBox);

      select(pack);
      reset();
      new ResizeObserver(measurePans).observe(kb);
      // Phones scroll the keyboard sideways; start with G and H in the middle.
      const frame = kb.parentElement!;
      const home = keyEls.get("KeyH")!.getBoundingClientRect();
      frame.scrollLeft += home.left - frame.getBoundingClientRect().width / 2;

      // The opening move: flat MacBook keys rise into keycaps, left to right.
      for (const [, el] of keyEls) {
        const r = el.getBoundingClientRect();
        const box = kb.getBoundingClientRect();
        el.style.setProperty("--delay", `${Math.round(((r.left - box.left) / box.width) * 420)}ms`);
      }
      if (reduceMotion) setOn(true);
      else {
        kb.dataset.mech = "false";
        setTimeout(() => setOn(true), 450);
      }
    </script>

    <style is:global>
